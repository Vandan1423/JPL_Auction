<%#
    Image upload field with live preview.
    Params: name, label, image ({url}), preset, removeName?, round?, icon?, hint?,
            crop? ("square" opens the crop dialog; default "fit" just resizes)
%>
<div class="image-field" data-image-field>
    <div class="image-field-preview <%= locals.round ? 'is-round' : '' %>" data-image-preview>
        <% if (image && image.url) { %>
            <img src="<%= img(image, preset) %>" alt="">
        <% } else { %>
            <i class="fa-solid <%= locals.icon || 'fa-image' %>"></i>
        <% } %>
    </div>
    <div class="image-field-body">
        <span class="image-field-label"><%= label %></span>
        <% if (uploadsEnabled) { %>
            <div class="image-field-actions">
                <label class="btn btn-secondary btn-sm">
                    <i class="fa-solid fa-upload"></i> <%= image && image.url ? 'Replace' : 'Choose image' %>
                    <input type="file" name="<%= name %>" accept="image/*" class="visually-hidden" data-image-input data-crop="<%= locals.crop || 'fit' %>">
                </label>
                <% if (image && image.url && locals.removeName) { %>
                    <label class="image-field-remove"><input type="checkbox" name="<%= removeName %>"> Remove</label>
                <% } %>
            </div>
            <small class="form-text"><%= locals.hint || 'JPG, PNG or WebP, up to 8 MB' %></small>
        <% } else { %>
            <small class="form-text warning"><i class="fa-solid fa-circle-info"></i> Uploads are off until CLOUDINARY_URL is added to .env</small>
        <% } %>
    </div>
</div>
