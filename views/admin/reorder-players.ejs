<%- include('../partials/header', { title, showNav: true, activePage: 'players' }) %>

<!-- SortableJS -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

<div class="players-container">
    <div class="page-header">
        <div>
            <h1><i class="fa-solid fa-arrow-up-wide-short"></i> Auction order</h1>
            <p class="page-subtitle">"Next player" in the control panel follows this order. Only players still in the pool are shown.</p>
        </div>
        <div class="header-actions">
            <a href="/admin/players" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Players</a>
            <button id="saveOrderBtn" class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Save order</button>
        </div>
    </div>

    <div class="glass-card-static arrange-card">
        <strong><i class="fa-solid fa-wand-magic-sparkles"></i> Arrange automatically:</strong>
        <% [
            ['category', 'By category (highest base price first)'],
            ['category-random', 'By category, shuffled within each'],
            ['random', 'Completely random'],
            ['number', 'By registration number'],
        ].forEach(([mode, label]) => { %>
            <form method="POST" action="/admin/players/reorder/auto">
                <input type="hidden" name="mode" value="<%= mode %>">
                <button type="submit" class="btn btn-ghost btn-sm" data-confirm="Rearrange all <%= players.length %> players? Your manual order will be replaced."><%= label %></button>
            </form>
        <% }) %>
    </div>

    <% if (players.length) { %>
        <div id="save-banner" class="alert alert-warning" hidden>
            <i class="fa-solid fa-triangle-exclamation"></i> You have unsaved changes. Click <strong>Save order</strong> to apply them.
        </div>

        <div class="table-container">
            <table class="players-table" id="reorderTable">
                <thead>
                    <tr><th style="width:40px;"></th><th style="width:60px;">Order</th><th>#</th><th>Name</th><th>Category</th><th>Role</th><th>Base price</th></tr>
                </thead>
                <tbody id="sortableBody">
                    <% players.forEach((player, index) => { %>
                        <% const category = categoryOf(player.category); %>
                        <tr class="sortable-row" data-id="<%= player._id %>">
                            <td class="drag-handle" title="Drag to reorder"><i class="fa-solid fa-grip-vertical"></i></td>
                            <td class="order-num"><%= index + 1 %></td>
                            <td><strong>#<%= player.playerNumber %></strong></td>
                            <td><%= player.name %><% if (player.status === 'unsold') { %> <span class="chip chip-warning">unsold</span><% } %></td>
                            <td><%- categoryBadge(player.category) %></td>
                            <td><%= player.role %></td>
                            <td><%= category ? money(category.basePrice) : '—' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="no-data">
            <i class="fa-solid fa-users-slash"></i>
            <p>No players are waiting to be auctioned.</p>
            <a href="/admin/players/add" class="btn btn-primary">Add players</a>
        </div>
    <% } %>
</div>

<script>
(function () {
    const tbody = document.getElementById('sortableBody');
    if (!tbody) return;
    let dirty = false;

    Sortable.create(tbody, {
        handle: '.drag-handle',
        animation: 150,
        ghostClass: 'sortable-ghost',
        onEnd() {
            tbody.querySelectorAll('.sortable-row').forEach((row, i) => { row.querySelector('.order-num').textContent = i + 1; });
            dirty = true;
            document.getElementById('save-banner').hidden = false;
        },
    });

    document.getElementById('saveOrderBtn').addEventListener('click', async (event) => {
        const button = event.currentTarget;
        const playerIds = [...tbody.querySelectorAll('.sortable-row')].map((r) => r.dataset.id);
        button.disabled = true;
        try {
            const res = await fetch('/admin/api/players/reorder', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ playerIds }),
            });
            const data = await res.json();
            if (!data.success) throw new Error(data.message);
            dirty = false;
            document.getElementById('save-banner').hidden = true;
            showToast('Order saved', 'success');
        } catch (error) {
            showToast('Could not save the order: ' + error.message, 'error');
        } finally {
            button.disabled = false;
        }
    });

    window.addEventListener('beforeunload', (e) => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
})();
</script>

<%- include('../partials/footer') %>
