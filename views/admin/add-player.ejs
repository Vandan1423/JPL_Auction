<%- include('../partials/header', { title, showNav: true, activePage: 'players' }) %>

<div class="form-container wide">
    <div class="form-header">
        <h1><i class="fa-solid fa-user-plus"></i> Add player</h1>
        <p>Each player gets the next registration number automatically. After saving, the form is ready for the next player.</p>
    </div>

    <% if (errors.length) { %>
        <div class="alert alert-error" role="alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <div><strong>Please fix:</strong><ul class="error-list"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
        </div>
    <% } %>

    <form method="POST" action="/admin/players/add" enctype="multipart/form-data" class="player-form" id="playerForm" data-player-form>
        <%- include('../partials/player-form-fields', { values }) %>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg" data-submit-label="Saving…"><i class="fa-solid fa-plus"></i> Add player</button>
            <a href="/admin/players" class="btn btn-outline"><i class="fa-solid fa-list"></i> All players</a>
            <a href="/admin/players/bulk" class="btn btn-ghost"><i class="fa-solid fa-list-check"></i> Add many at once</a>
        </div>
    </form>
</div>

<script src="/js/player-form.js"></script>
<%- include('../partials/footer') %>
