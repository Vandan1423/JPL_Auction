<%- include('../partials/header', { title, showNav: true, activePage: 'auction' }) %>

<div class="auction-control-container" id="auctionControl">
    <div class="auction-main-area">

        <!-- Left: choose the next player -->
        <aside class="auction-sidebar">
            <div class="sidebar-section next-player-actions">
                <button type="button" class="btn btn-primary" id="nextPlayerBtn" title="Next player in the auction order (N)">
                    <i class="fa-solid fa-forward-step"></i> Next player <kbd>N</kbd>
                </button>
                <button type="button" class="btn btn-secondary" id="randomPlayerBtn" title="Random player from the selected category (R)">
                    <i class="fa-solid fa-shuffle"></i> Random <kbd>R</kbd>
                </button>
                <p class="next-player-hint" id="nextPlayerHint" hidden>Mark the current player SOLD or UNSOLD to move on.</p>
            </div>

            <div class="sidebar-section">
                <h3><i class="fa-solid fa-users"></i> Players in the pool</h3>
                <div class="category-filters" id="categoryFilters"></div>
                <input type="search" id="playerSearch" class="form-control form-control-sm" placeholder="Search player…" autocomplete="off">
                <div class="reorder-bar">
                    <button type="button" id="toggleReorderBtn" class="btn btn-ghost btn-sm"><i class="fa-solid fa-arrow-up-down"></i> Reorder</button>
                    <span id="reorderStatus" class="muted"></span>
                </div>
                <div class="players-list" id="playersList"></div>
            </div>

            <div class="sidebar-section">
                <h3><i class="fa-solid fa-clock-rotate-left"></i> Bid history</h3>
                <div class="bid-history" id="bidHistory"></div>
            </div>
        </aside>

        <!-- Centre: the player under the hammer and the teams -->
        <section class="auction-center">
            <div class="current-player-panel" id="currentPlayerPanel"></div>
            <div class="teams-bidding-grid" id="teamsBiddingGrid"></div>
        </section>

        <!-- Right: result buttons -->
        <aside class="auction-sidebar-right">
            <div class="sidebar-stats">
                <div class="sidebar-stat-item"><span class="stat-label">Round</span><span class="stat-value" id="roundNumber">0</span></div>
                <div class="sidebar-stat-item"><span class="stat-label">Sold</span><span class="stat-value stat-success" id="soldCount">0</span></div>
                <div class="sidebar-stat-item"><span class="stat-label">In pool</span><span class="stat-value stat-warning" id="poolCount">0</span></div>
            </div>

            <div class="sidebar-section sidebar-actions">
                <button type="button" class="btn btn-success btn-large" id="soldBtn" disabled><i class="fa-solid fa-check"></i> Sold</button>
                <button type="button" class="btn btn-danger btn-large" id="unsoldBtn" disabled><i class="fa-solid fa-xmark"></i> Unsold</button>
                <button type="button" class="btn btn-secondary btn-undo" id="withdrawBtn" disabled><i class="fa-solid fa-user-slash"></i> Withdraw player</button>
                <button type="button" class="btn btn-secondary btn-undo" id="undoBtn"><i class="fa-solid fa-rotate-left"></i> Undo last sale</button>
                <a class="btn btn-secondary btn-undo" href="/display/<%= tournament.slug %>" target="_blank" rel="noopener"><i class="fa-solid fa-tv"></i> Open live display</a>
                <button type="button" class="btn btn-ghost btn-undo" id="shortcutsBtn"><i class="fa-solid fa-keyboard"></i> Shortcuts</button>
            </div>

            <div class="sidebar-section">
                <h3><i class="fa-solid fa-receipt"></i> Recent sales</h3>
                <div class="recent-sales" id="recentSales"></div>
            </div>
        </aside>
    </div>
</div>

<div id="toastContainer" class="toast-container"></div>

<!-- Confirmation -->
<div id="confirmModal" class="modal" style="display: none;">
    <div class="modal-content">
        <h3 id="confirmTitle">Confirm</h3>
        <p id="confirmMessage"></p>
        <div class="modal-actions">
            <button class="btn btn-primary" id="confirmYes">Yes</button>
            <button class="btn btn-secondary" id="confirmNo">Cancel</button>
        </div>
    </div>
</div>

<!-- Custom bid -->
<div class="modal" id="customBidModal" style="display: none;">
    <div class="modal-content">
        <h3>Custom bid</h3>
        <p>Team: <strong id="customBidTeamName"></strong></p>
        <p id="customBidHint" class="muted"></p>
        <form id="customBidForm">
            <div class="form-group">
                <label for="customBidInput">Bid amount</label>
                <div class="input-affix"><span><%= currencyLabel %></span>
                    <input type="number" id="customBidInput" class="form-control" min="1" step="1" required>
                </div>
            </div>
            <div class="modal-actions">
                <button type="submit" class="btn btn-primary">Place bid</button>
                <button type="button" class="btn btn-secondary" id="customBidCancel">Cancel</button>
            </div>
        </form>
    </div>
</div>

<!-- Keyboard shortcuts -->
<dialog id="shortcutsDialog" class="app-dialog">
    <h3><i class="fa-solid fa-keyboard" style="color: var(--primary)"></i> Keyboard shortcuts</h3>
    <div class="shortcuts-grid">
        <div class="shortcut-item"><kbd>1</kbd>–<kbd>9</kbd><span>Bid for team 1–9 (<kbd>0</kbd> = team 10)</span></div>
        <div class="shortcut-item"><kbd>N</kbd><span>Next player in order</span></div>
        <div class="shortcut-item"><kbd>R</kbd><span>Random player</span></div>
        <div class="shortcut-item"><kbd>Space</kbd><span>Sold</span></div>
        <div class="shortcut-item"><kbd>U</kbd><span>Unsold</span></div>
        <div class="shortcut-item"><kbd>Ctrl/⌘</kbd> + <kbd>Z</kbd><span>Undo last sale</span></div>
        <div class="shortcut-item"><kbd>/</kbd><span>Search players</span></div>
    </div>
    <div class="dialog-actions"><button class="btn btn-primary" data-close-dialog>Got it</button></div>
</dialog>

<script>
    window.AUCTION_INITIAL = <%- json({ snapshot, queue, categories }) %>;
</script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script defer src="/js/auction-control.js"></script>

<%- include('../partials/footer') %>
