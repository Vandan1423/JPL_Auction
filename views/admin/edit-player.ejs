<%- include('../partials/header', { title, showNav: true, activePage: 'players' }) %>

<% const statusLabels = { available: 'Not auctioned yet', unsold: 'Unsold', sold: 'Sold', withdrawn: 'Withdrawn' }; %>

<div class="form-container wide">
    <div class="form-header">
        <h1><i class="fa-solid fa-user-pen"></i> Edit player</h1>
        <p>#<%= player.playerNumber %> · <span class="status-badge status-<%= player.status %>"><%= statusLabels[player.status] %></span></p>
    </div>

    <% if (errors.length) { %>
        <div class="alert alert-error" role="alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <div><strong>Please fix:</strong><ul class="error-list"><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
        </div>
    <% } %>

    <form method="POST" action="/admin/players/edit/<%= player._id %>" enctype="multipart/form-data" class="player-form" id="playerForm" data-player-form>
        <% if (player.status === 'sold' && player.soldTo) { %>
            <div class="sold-info-box">
                <strong>Sold to <%= player.soldTo.name %></strong> for <%= money(player.soldPrice) %>
            </div>
        <% } %>

        <%- include('../partials/player-form-fields', {
            values,
            lockCategory: player.status === 'sold',
            existingPhoto: player.photo,
        }) %>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg" data-submit-label="Saving…"><i class="fa-solid fa-floppy-disk"></i> Save changes</button>
            <a href="/admin/players" class="btn btn-outline"><i class="fa-solid fa-arrow-left"></i> Cancel</a>
        </div>
    </form>
</div>

<script src="/js/player-form.js"></script>
<%- include('../partials/footer') %>
