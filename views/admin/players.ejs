<%- include('../partials/header', { title, showNav: true, activePage: 'players' }) %>

<% const statusLabels = { available: 'Not auctioned', unsold: 'Unsold', sold: 'Sold', withdrawn: 'Withdrawn' }; %>
<% const phoneShown = (tournament.playerFields && tournament.playerFields.phone) !== 'hidden'; %>

<div class="players-container">
    <div class="page-header">
        <h1><i class="fa-solid fa-users"></i> Players</h1>
        <div class="header-actions">
            <a href="/admin/players/add" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> Add player</a>
            <a href="/admin/players/bulk" class="btn btn-secondary"><i class="fa-solid fa-list-check"></i> Bulk add</a>
            <a href="/admin/players/reorder" class="btn btn-secondary"><i class="fa-solid fa-arrow-up-wide-short"></i> Auction order</a>
        </div>
    </div>

    <div class="filters-section glass-card">
        <form method="GET" action="/admin/players" class="filters-form">
            <div class="filter-group">
                <label for="search">Search by name</label>
                <input type="text" id="search" name="search" placeholder="Player name…" value="<%= appliedFilters.search %>" class="form-control">
            </div>
            <div class="filter-group">
                <label for="category">Category</label>
                <select name="category" id="category" class="form-control">
                    <option value="all">All categories</option>
                    <% tournament.categories.forEach(c => { %>
                        <option value="<%= c._id %>" <%= appliedFilters.category === String(c._id) ? 'selected' : '' %>><%= c.name %> (<%= money(c.basePrice) %>)</option>
                    <% }) %>
                </select>
            </div>
            <div class="filter-group">
                <label for="role">Role</label>
                <select name="role" id="role" class="form-control">
                    <option value="all">All roles</option>
                    <% tournament.roles.forEach(r => { %>
                        <option value="<%= r %>" <%= appliedFilters.role === r ? 'selected' : '' %>><%= r %></option>
                    <% }) %>
                </select>
            </div>
            <div class="filter-group">
                <label for="status">Status</label>
                <select name="status" id="status" class="form-control">
                    <option value="all">All statuses</option>
                    <option value="pool" <%= appliedFilters.status === 'pool' ? 'selected' : '' %>>In the pool</option>
                    <% Object.entries(statusLabels).forEach(([value, label]) => { %>
                        <option value="<%= value %>" <%= appliedFilters.status === value ? 'selected' : '' %>><%= label %></option>
                    <% }) %>
                </select>
            </div>
            <div class="filter-group">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter"></i> Apply</button>
                <a href="/admin/players" class="btn btn-secondary"><i class="fa-solid fa-xmark"></i> Clear</a>
            </div>
        </form>
    </div>

    <div class="stats-bar">
        <div class="stat-item"><span class="stat-label">Total:</span> <span class="stat-value"><%= statusCounts.total %></span></div>
        <div class="stat-item"><span class="stat-label">Not auctioned:</span> <span class="stat-value"><%= statusCounts.available %></span></div>
        <div class="stat-item"><span class="stat-label">Unsold:</span> <span class="stat-value stat-warning"><%= statusCounts.unsold %></span></div>
        <div class="stat-item"><span class="stat-label">Sold:</span> <span class="stat-value stat-success"><%= statusCounts.sold %></span></div>
        <div class="stat-item"><span class="stat-label">Withdrawn:</span> <span class="stat-value stat-danger"><%= statusCounts.withdrawn %></span></div>
    </div>

    <div class="table-container">
        <% if (players.length) { %>
            <table class="players-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Player</th>
                        <th>Role</th>
                        <th>Category</th>
                        <th>Base price</th>
                        <% if (phoneShown) { %><th>Phone</th><% } %>
                        <th>Status</th>
                        <th>Sold to</th>
                        <th>Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% players.forEach(player => { %>
                        <% const category = categoryOf(player.category); %>
                        <tr>
                            <td><strong>#<%= player.playerNumber %></strong></td>
                            <td>
                                <div class="player-cell">
                                    <% if (player.photoThumb) { %>
                                        <img src="<%= player.photoThumb %>" alt="" class="player-avatar">
                                    <% } else { %>
                                        <span class="player-avatar initials"><%= player.name.charAt(0).toUpperCase() %></span>
                                    <% } %>
                                    <span><%= player.name %></span>
                                </div>
                            </td>
                            <td><%= player.role || '—' %></td>
                            <td><%- categoryBadge(player.category) %></td>
                            <td><%= category ? money(category.basePrice) : '—' %></td>
                            <% if (phoneShown) { %><td><%= player.phone || '—' %></td><% } %>
                            <td>
                                <span class="status-badge status-<%= player.status %>"><%= statusLabels[player.status] %></span>
                                <% if (player.timesUnsold) { %><small class="muted"> ×<%= player.timesUnsold %></small><% } %>
                            </td>
                            <td><%= player.soldTo ? player.soldTo.name : '—' %></td>
                            <td><%= player.status === 'sold' ? money(player.soldPrice) : '—' %></td>
                            <td class="actions-cell">
                                <a href="/admin/players/edit/<%= player._id %>" class="btn btn-sm btn-secondary" title="Edit"><i class="fa-solid fa-pen"></i> Edit</a>
                                <% if (player.status !== 'sold') { %>
                                    <form method="POST" action="/admin/players/delete/<%= player._id %>" style="display: inline;">
                                        <button type="submit" class="btn btn-sm btn-danger" title="Delete" data-confirm="Delete <%= player.name %>? This cannot be undone.">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        <% } else { %>
            <div class="no-data">
                <i class="fa-solid fa-users-slash"></i>
                <p><%= statusCounts.total ? 'No players match these filters.' : 'No players yet.' %></p>
                <a href="/admin/players/add" class="btn btn-primary"><i class="fa-solid fa-user-plus"></i> Add a player</a>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>
