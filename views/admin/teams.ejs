<%- include('../partials/header', { title, showNav: true, activePage: 'teams' }) %>

<div class="teams-management-container">
    <div class="page-header">
        <div>
            <h1><i class="fa-solid fa-shield-halved"></i> Teams</h1>
            <p class="page-subtitle">Squads, purses and category mix. Names, logos and owners are edited in setup.</p>
        </div>
        <a href="/admin/setup/5" class="btn btn-secondary"><i class="fa-solid fa-pen"></i> Edit teams &amp; owners</a>
    </div>

    <div class="auction-stats">
        <div class="stat-card"><h3><%= totals.sold %>/<%= totals.total %></h3><p>Players sold</p></div>
        <div class="stat-card"><h3><%= money(totals.spent) %></h3><p>Total spent</p></div>
        <div class="stat-card"><h3><%= totals.pool %></h3><p>Players in the pool</p></div>
        <div class="stat-card"><h3><%= money(totals.remaining) %></h3><p>Purse remaining</p></div>
    </div>

    <div class="teams-grid">
        <% teams.forEach(team => { %>
            <% const percentFull = Math.min(100, (team.playersCount / tournament.squad.max) * 100); %>
            <div class="team-card" style="border-left: 5px solid <%= team.color %>">
                <div class="team-header">
                    <% if (team.logo && team.logo.url) { %>
                        <img src="<%= img(team.logo, 'logoSm') %>" alt="" class="team-logo" style="width: 50px; height: 50px; object-fit: contain; margin-right: 10px;">
                    <% } %>
                    <h2 style="color: <%= team.color %>"><%= team.name %></h2>
                    <span class="team-number">#<%= team.order %></span>
                </div>

                <div class="team-info">
                    <div class="info-row">
                        <span class="label">Owner:</span>
                        <span class="value"><%= team.owner && team.owner.name ? team.owner.name : 'Not set' %><% if (team.owner && team.owner.isPlaying) { %> <span class="chip chip-info">plays</span><% } %></span>
                    </div>
                    <div class="info-row">
                        <span class="label">Players:</span>
                        <span class="value">
                            <%= team.playersCount %>/<%= tournament.squad.max %>
                            <div class="progress-bar"><div class="progress-fill" style="width: <%= percentFull %>%; background: <%= team.color %>"></div></div>
                        </span>
                    </div>
                    <div class="info-row"><span class="label">Remaining purse:</span><span class="value value-highlight"><%= money(team.remainingPurse) %></span></div>
                    <div class="info-row"><span class="label">Spent:</span><span class="value"><%= money(team.spent) %></span></div>
                    <div class="info-row"><span class="label">Max bid now:</span><span class="value"><%= money(team.maxBidAllowed) %></span></div>
                </div>

                <div class="category-breakdown">
                    <h4>Squad composition</h4>
                    <div class="category-badges">
                        <% tournament.categories.forEach(c => { %>
                            <span class="badge cat-badge" style="--cat: <%= c.color %>"><%= c.name %>: <%= team.categoryCounts[String(c._id)] || 0 %><%= c.maxPerTeam !== null && c.maxPerTeam !== undefined ? `/${c.maxPerTeam}` : '' %></span>
                        <% }) %>
                    </div>
                </div>

                <div class="team-actions">
                    <a href="/admin/teams/<%= team._id %>" class="btn btn-sm btn-primary"><i class="fa-solid fa-eye"></i> Squad</a>
                    <a href="/admin/reports/team-pdf/<%= team._id %>" class="btn btn-sm btn-secondary"><i class="fa-solid fa-file-pdf"></i> PDF</a>
                    <form method="POST" action="/admin/teams/<%= team._id %>/reset" style="display:inline">
                        <button type="submit" class="btn btn-sm btn-danger" data-confirm="Release every player <%= team.name %> bought back into the auction pool? The purse is refunded. A playing owner stays.">
                            <i class="fa-solid fa-rotate-left"></i> Release squad
                        </button>
                    </form>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<%- include('../partials/footer') %>
