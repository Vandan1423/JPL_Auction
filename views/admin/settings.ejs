<%- include('../partials/header', { title, showNav: true, activePage: 'settings' }) %>

<div class="settings-container page-container">
    <div class="page-header">
        <div>
            <h1><i class="fa-solid fa-gear"></i> Settings</h1>
            <p class="page-subtitle"><%= tournament.name %><%= tournament.season ? ` · ${tournament.season}` : '' %></p>
        </div>
    </div>

    <div class="glass-card-static">
        <h2><i class="fa-solid fa-sliders"></i> Tournament setup</h2>
        <p class="setup-help">Every answer from the setup wizard can be changed here.<% if (started) { %> Since the auction has started, settings that would change purses or squads are locked until you reset the auction.<% } %></p>
        <div class="settings-steps">
            <% steps.forEach(s => { %>
                <a class="settings-step" href="/admin/setup/<%= s.n %>">
                    <i class="fa-solid <%= s.icon %>"></i>
                    <span><strong><%= s.title %></strong><small><%= s.hint %></small></span>
                    <% if (started && [2].includes(s.n)) { %><i class="fa-solid fa-lock muted" title="Locked while the auction is running"></i><% } %>
                </a>
            <% }) %>
        </div>
    </div>

    <div class="glass-card-static">
        <h2><i class="fa-solid fa-tv"></i> Live display</h2>
        <p class="setup-help">Open this on the projector or TV. It updates instantly as you run the auction.</p>
        <div class="copy-row">
            <input type="text" class="form-control" value="<%= displayUrl %>" readonly id="displayUrl">
            <button type="button" class="btn btn-secondary" data-copy="#displayUrl"><i class="fa-solid fa-copy"></i> Copy</button>
            <a class="btn btn-primary" href="<%= displayUrl %>" target="_blank" rel="noopener"><i class="fa-solid fa-up-right-from-square"></i> Open</a>
        </div>
    </div>

    <div class="glass-card-static">
        <h2><i class="fa-solid fa-images"></i> Image uploads</h2>
        <% if (cloudinaryReady) { %>
            <p><span class="chip chip-success"><i class="fa-solid fa-check"></i> Connected to Cloudinary</span> Player photos, team logos and owner photos are stored in Cloudinary; only their links are saved in the database.</p>
            <% if (cloudinaryUsage) { const pct = Math.min(100, cloudinaryUsage.usedPercent); const level = cloudinaryUsage.usedPercent >= 100 ? 'is-full' : cloudinaryUsage.usedPercent >= 80 ? 'is-high' : ''; %>
                <div class="usage-meter <%= level %>">
                    <div class="usage-meter-label">
                        <span><%= cloudinaryUsage.plan %> plan: <strong><%= cloudinaryUsage.used %> of <%= cloudinaryUsage.limit %></strong> monthly credits used</span>
                        <strong><%= cloudinaryUsage.usedPercent.toFixed(1) %>%</strong>
                    </div>
                    <div class="usage-meter-track" role="progressbar" aria-valuenow="<%= Math.round(pct) %>" aria-valuemin="0" aria-valuemax="100"><div class="usage-meter-fill" style="width: <%= pct %>%"></div></div>
                    <p class="muted">Credits are counted over a rolling 30 days (1 credit ≈ 1 GB of storage or bandwidth, or 1,000 image resizes). At 100%, uploads stop until usage drops.</p>
                </div>
            <% } %>
        <% } else { %>
            <p><span class="chip chip-warning"><i class="fa-solid fa-triangle-exclamation"></i> Not set up</span> Uploads are switched off. To turn them on:</p>
            <ol class="settings-steps-list">
                <li>Create a free account at cloudinary.com</li>
                <li>From the Cloudinary console copy your <strong>Cloud name</strong> (top of the dashboard) and, under <strong>Settings → API Keys</strong>, the <strong>API key</strong> and <strong>API secret</strong></li>
                <li>Set them as <code>CLOUDINARY_CLOUD_NAME</code>, <code>CLOUDINARY_API_KEY</code> and <code>CLOUDINARY_API_SECRET</code>: in <code>.env</code> locally, or in your host's environment variables (Vercel → Project → Settings → Environment Variables). Then restart or redeploy.</li>
            </ol>
        <% } %>
    </div>

    <div class="glass-card-static">
        <h2><i class="fa-solid fa-chart-simple"></i> Auction progress</h2>
        <div class="stats-grid">
            <div class="stat-card stat-primary"><div class="stat-content"><h3><%= counts.total %></h3><p>Players</p></div></div>
            <div class="stat-card stat-success"><div class="stat-content"><h3><%= counts.sold %></h3><p>Sold</p></div></div>
            <div class="stat-card stat-warning"><div class="stat-content"><h3><%= counts.pool %></h3><p>In the pool</p></div></div>
            <div class="stat-card stat-info"><div class="stat-content"><h3><%= roundNumber %></h3><p>Players auctioned</p></div></div>
        </div>
    </div>

    <div class="danger-zone glass-card-static">
        <h2><i class="fa-solid fa-triangle-exclamation"></i> Danger zone</h2>
        <div class="danger-row">
            <div>
                <strong>Reset the auction</strong>
                <p class="muted">Every sold and unsold player goes back into the pool (and back to their original category), and all purses refill. Players, teams and owners are kept.</p>
            </div>
            <form method="POST" action="/admin/settings/reset-auction" class="danger-form">
                <input type="text" name="confirm" class="form-control" placeholder="Type RESET" autocomplete="off" required>
                <button type="submit" class="btn btn-danger"><i class="fa-solid fa-rotate"></i> Reset auction</button>
            </form>
        </div>
        <div class="danger-row">
            <div>
                <strong>Delete this tournament</strong>
                <p class="muted">Permanently removes <strong><%= tournament.name %></strong> with all its teams, owners, players, sales and auction history from the database, and every photo and logo from Cloudinary. It cannot be undone.</p>
            </div>
            <form method="POST" action="/admin/tournaments/<%= tournament._id %>/delete" class="danger-form" id="deleteTournamentForm">
                <input type="text" name="confirmName" class="form-control confirm-name" placeholder="Type <%= tournament.name %>" autocomplete="off" required data-expected="<%= tournament.name %>">
                <button type="submit" class="btn btn-danger" disabled><i class="fa-solid fa-trash"></i> Delete tournament</button>
            </form>
        </div>
    </div>
</div>

<script>
(function () {
    const form = document.getElementById('deleteTournamentForm');
    const input = form.querySelector('input');
    const button = form.querySelector('button');
    input.addEventListener('input', () => { button.disabled = input.value.trim() !== input.dataset.expected; });
})();
document.querySelectorAll('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
        const input = document.querySelector(button.dataset.copy);
        try {
            await navigator.clipboard.writeText(input.value);
            showToast('Link copied', 'success');
        } catch {
            input.select();
        }
    });
});
</script>

<%- include('../partials/footer') %>
