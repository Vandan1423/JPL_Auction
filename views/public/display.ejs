<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%= tournament.name %> · Live Auction</title>
        <link rel="stylesheet" href="/css/display.css" />
        <script src="/socket.io/socket.io.js"></script>
    </head>
    <body>
        <div class="display-container">
            <header class="display-header">
                <div class="header-content">
                    <div class="tournament-branding">
                        <img src="<%= logoUrl || '/images/logo.svg' %>" alt="" class="tournament-logo" onerror="this.style.display='none'" />
                        <div class="tournament-title-wrap">
                            <h1 class="tournament-title"><%= tournament.name.toUpperCase() %></h1>
                            <% if (tournament.season) { %><span class="tournament-season"><%= tournament.season %> · Player Auction</span><% } %>
                        </div>
                    </div>
                    <div class="header-stats">
                        <span class="header-stat">Round: <strong id="displayRound">0</strong></span>
                        <span class="header-stat">Sold: <strong id="displaySold">0</strong>/<span id="displayTotal">0</span></span>
                        <span class="header-stat connection-status" id="connectionStatus">🟢 Live</span>
                        <span class="header-stat"><strong id="liveClock"></strong></span>
                    </div>
                </div>
            </header>

            <main class="display-main">
                <section class="current-player-section" id="currentPlayerSection"></section>
                <section class="teams-display-section">
                    <div class="teams-grid" id="teamsDisplayGrid"></div>
                </section>
            </main>
        </div>

        <canvas id="crackersCanvas"></canvas>

        <div id="soldOverlay" class="result-overlay result-overlay--sold" style="display: none">
            <div class="result-overlay__backdrop"></div>
            <div class="result-overlay__content">
                <div class="result-overlay__badge result-overlay__badge--sold">SOLD!</div>
                <div class="result-overlay__player-photo-wrap" id="soldPlayerPhoto"></div>
                <div class="result-overlay__player" id="soldPlayerName"></div>
                <div class="result-overlay__divider"></div>
                <div class="result-overlay__team-row">
                    <img class="result-overlay__team-logo" id="soldTeamLogo" src="" alt="" />
                    <span class="result-overlay__team-name" id="soldTeamName"></span>
                </div>
                <div class="result-overlay__price" id="soldPrice"></div>
            </div>
        </div>

        <div id="unsoldOverlay" class="result-overlay result-overlay--unsold" style="display: none">
            <div class="result-overlay__backdrop"></div>
            <div class="result-overlay__content">
                <div class="result-overlay__badge result-overlay__badge--unsold">UNSOLD</div>
                <div class="result-overlay__player-photo-wrap" id="unsoldPlayerPhoto"></div>
                <div class="result-overlay__player" id="unsoldPlayerName"></div>
                <p class="result-overlay__subtitle" id="unsoldSubtitle"></p>
            </div>
        </div>

        <script>
            window.DISPLAY_CONFIG = <%- json({
                tournamentId: String(tournament._id),
                slug: tournament.slug,
                currency: { symbol: currency.symbol, suffix: currency.suffix || '', locale: currency.locale },
                snapshot,
            }) %>;
        </script>
        <script src="/js/display.js"></script>
    </body>
</html>
