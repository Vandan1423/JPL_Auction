PORT=3000
NODE_ENV=development
# Local MongoDB, or a MongoDB Atlas connection string when deployed
MONGODB_URI=mongodb://localhost:27017/auction-hub
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_PASSWORD=admin123

# Image uploads (player photos, team logos, owner photos).
# From the Cloudinary console: Cloud name (top of the dashboard) and
# Settings → API Keys → API key / API secret.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# …or instead of the three lines above, the single "API environment variable":
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
